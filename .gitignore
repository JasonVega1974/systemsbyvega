.claude/settings.local.json
node_modules/
.vercel

# Local secrets. `vercel env pull` writes .env.local into the repo root, and
# that file holds SUPABASE_SERVICE_ROLE_KEY and SBV_OWNER_KEY in plain text.
.env*
!.env.example
.superpowers/

# Stray agent screenshots. Review agents render pages to disk while checking
# them; a bare numeric PNG in the repo root is one that escaped a scratch dir,
# and `git add -A` would otherwise commit megabytes of it.
/[0-9]*.png

# Supabase CLI local link state — machine-specific, not shared config.
supabase/.temp/

# tools/build-shots.js's scratch rebuild for hero/2-branded. Removed by the
# tool itself after every run (success or failure); this is a backstop only.
/.sbv-hero3-build/

# tools/preview-email.mjs output. Rendered from the live sendWelcome() /
# sendLoginLink(), so it is regenerated on demand and never worth committing —
# a checked-in copy is exactly the stale duplicate the tool exists to avoid.
/.preview/

# The hero photograph's ORIGINAL, as Jason supplied it. tools/build-hero-image.js
# re-encodes it into assets/hero/owner.jpg (138 KB), which is the file the site
# actually ships; 1.5 MB of PNG carrying the same picture has no reason to be in
# the repo beside it. Kept on disk so the encode stays repeatable, never committed.
/assets/hero/owner-source.png
